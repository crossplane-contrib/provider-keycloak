{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "labels": [
    "renovatebot",
    "dependencies"
  ],
  "extends": [
    "config:recommended",
    ":semanticCommits",
    "helpers:pinGitHubActionDigests",
    ":automergeRequireAllStatusChecks",
    "schedule:weekly"
  ],
  "baseBranchPatterns": [
    "main"
  ],
  "postUpdateOptions": [
    "gomodTidy"
  ],
  "dependencyDashboard": true,
  "recreateWhen": "always",
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "makefile dependencies",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "Makefile"
      ],
      "matchDepNames": [
        "golangci/golangci-lint",
        "kubernetes/kubernetes",
        "kubernetes-sigs/kind",
        "upbound/up",
        "crossplane-contrib/uptest",
        "kyverno/chainsaw",
        "crossplane/crossplane",
        "hashicorp/terraform"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "hugo version",
      "matchDepNames": [
        "gohugoio/hugo"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Terraform 1.6+ is not allowed due to BSL licensing",
      "matchDepNames": [
        "hashicorp/terraform"
      ],
      "allowedVersions": "<1.6.0"
    },
    {
      "description": "Prevent the github-actions manager from misidentifying hugo-version as a Go version in docs workflows. The github-actions manager incorrectly treats peaceiris/actions-hugo's hugo-version input as a Go version dep. Disable exact-version Go updates from github-actions in those files; actions/setup-go uses range notation (1.x) which is excluded by this pattern.",
      "matchManagers": [
        "github-actions"
      ],
      "matchFileNames": [
        ".github/workflows/deploy-docs.yml",
        ".github/workflows/preview-docs.yml"
      ],
      "matchDepNames": [
        "go",
        "golang",
        "golang/go"
      ],
      "matchCurrentVersion": "/^\\d+\\.\\d+\\.\\d+$/",
      "enabled": false
    },
    {
      "groupName": "go versions",
      "matchManagers": [
        "gomod",
        "github-actions",
        "custom.regex"
      ],
      "matchDepNames": [
        "go",
        "golang",
        "golang/go"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "terraform-provider-keycloak",
      "description": "Keycloak Terraform provider used by the code generator (go.mod pseudo-version) and its pinned version in the Makefile, grouped and reviewed together weekly since upgrading requires deliberate schema migration.",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchDepNames": [
        "github.com/keycloak/terraform-provider-keycloak",
        "keycloak/terraform-provider-keycloak"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "automerge": true
    },
    {
      "groupName": "terraform-provider-keycloak",
      "description": "Major version bumps of the Keycloak Terraform provider require deliberate schema migration and are not auto-merged.",
      "matchManagers": [
        "gomod",
        "custom.regex"
      ],
      "matchDepNames": [
        "github.com/keycloak/terraform-provider-keycloak",
        "keycloak/terraform-provider-keycloak"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "GO_REQUIRED_VERSION \\?= (?<currentValue>.*)"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/.*\\.yml$/"
      ],
      "matchStrings": [
        "GO_VERSION:\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(deploy-docs|preview-docs)\\.yml$/"
      ],
      "matchStrings": [
        "go-version:\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "golang-version",
      "depNameTemplate": "go",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/(deploy-docs|preview-docs)\\.yml$/"
      ],
      "matchStrings": [
        "hugo-version:\\s*'(?<currentValue>[^']+)'"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "gohugoio/hugo",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "export TERRAFORM_PROVIDER_VERSION .*= (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "keycloak/terraform-provider-keycloak",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "export TERRAFORM_VERSION \\?= (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "hashicorp/terraform",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "export GOLANGCILINT_VERSION \\?= (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "golangci/golangci-lint",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "KUBECTL_VERSION \\?= (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes/kubernetes",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "KIND_VERSION = (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kubernetes-sigs/kind",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "UP_VERSION = (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "upbound/up",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "UPTEST_VERSION = (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "crossplane-contrib/uptest",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "CHAINSAW_VERSION = (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "kyverno/chainsaw",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "CROSSPLANE_VERSION = (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "crossplane/crossplane",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^Makefile$/"
      ],
      "matchStrings": [
        "CROSSPLANE_CLI_VERSION = (?<currentValue>.*)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "crossplane/crossplane",
      "versioningTemplate": "semver"
    }
  ]
}
